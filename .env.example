# Copiar para .env e ajustar. NUNCA versionar o ficheiro .env.

# Base de dados (docker-compose expõe o PostgreSQL na porta 5433)
DATABASE_URL="postgresql://magnezya:magnezya_dev@localhost:5433/magnezya?schema=public"

# Better Auth — gerar um segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET="substituir-por-um-segredo-longo-e-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# Palavra-passe dos utilizadores de demonstração criados pelo seed (só desenvolvimento)
SEED_DEFAULT_PASSWORD="Magnezya#2026"

# Pasta onde ficam as fotografias carregadas (desenvolvimento / servidor único)
STORAGE_DIR="storage"

# Marca da instalação (white-label). Sem valores, usa a marca de demonstração.
# NEXT_PUBLIC_BRAND_NAME="Magnezya"
# NEXT_PUBLIC_BRAND_TAGLINE="Event Support"
# NEXT_PUBLIC_BRAND_SEGMENTS="Corporate,Feiras,Congressos"
# NEXT_PUBLIC_BRAND_HEADLINE="Mobiliário e equipamento que transformam cada evento."
# NEXT_PUBLIC_BRAND_DESCRIPTION="Soluções completas de aluguer para eventos…"
