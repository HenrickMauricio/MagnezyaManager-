# Copiar para .env e ajustar. NUNCA versionar o ficheiro .env.

# Base de dados (docker-compose expõe o PostgreSQL na porta 5433)
DATABASE_URL="postgresql://magnezya:magnezya_dev@localhost:5433/magnezya?schema=public"

# Better Auth — gerar um segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET="substituir-por-um-segredo-longo-e-aleatorio"
